# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Admin Dashboard Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="secure_password_here"

# ImageKit Configuration for Image Uploads & Optimization
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key"
IMAGEKIT_PRIVATE_KEY="your_imagekit_private_key"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# Google Drive Picker API (Optional for admin bulk uploads)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id"
NEXT_PUBLIC_GOOGLE_API_KEY="your_google_api_key"

# Database Configuration (Generic SQLite or Postgres)
# If using Postgres, replace this with your actual database URL
DATABASE_URL="file:./dev.db"
